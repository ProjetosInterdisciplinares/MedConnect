# Copie este arquivo para .env e preencha os valores.
# Nunca faça commit do .env (ele já está no .gitignore).

# --- Banco de dados ---
# Produção / banco no Neon: copie a connection string do painel do Neon
# (botão "Connect", com "Connection pooling" DESLIGADO).
# DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require

# Desenvolvimento local (usado quando DATABASE_URL não está definida)
DB_NAME=bdMedConnect
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Gemini (IA) ---
GOOGLE_API_KEY=
